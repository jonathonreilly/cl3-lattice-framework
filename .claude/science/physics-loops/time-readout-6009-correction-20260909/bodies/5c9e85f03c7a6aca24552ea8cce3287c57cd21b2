def teeth() -> dict:
    results = []

    # T1 tampered pin
    ax = norm(rd(AXIOMS_MD))
    tampered = ax.replace("content alone", "content and geometry")
    bit = (tampered.count(CONTENT_ALONE) == 0 and ax.count(CONTENT_ALONE) == 1)
    results.append({"tooth": "T1 tampered pin",
                    "mutation": "replace 'content alone' in the memo buffer",
                    "detector": "verbatim needle occurrence count",
                    "bites": bit,
                    "detail": {"clean": ax.count(CONTENT_ALONE),
                               "tampered": tampered.count(CONTENT_ALONE)}})

    # T2 dropped C2 class
    full = {class_name(H) for H in ALL_SUBS if len(H) == 2}
    dropped = full - {"C2_edge"}
    bit = len(dropped) < len(full)
    results.append({"tooth": "T2 dropped C2 class",
                    "mutation": "run the discriminator on C2_face only",
                    "detector": "gate 'both_C2_classes_computed'",
                    "bites": bit,
                    "detail": {"full": sorted(full), "dropped": sorted(dropped)}})

    # T3 hardcoded verdict
    def verdict_from(D_ok, R_ok, violation):
        if D_ok and not R_ok and violation:
            return "DECIDED-F_DIM"
        if R_ok and not D_ok:
            return "DECIDED-F_RES"
        return "UNDECIDABLE-PRICED"
    responses = {
        "D ok, R bad, violation": verdict_from(True, False, True),
        "D bad, R ok":            verdict_from(False, True, False),
        "both ok":                verdict_from(True, True, False),
    }
    bit = len(set(responses.values())) == 3
    results.append({"tooth": "T3 hardcoded verdict",
                    "mutation": "feed the selector three different predicate "
                                "tables",
                    "detector": "the selector must return three different "
                                "classes",
                    "bites": bit, "detail": responses})

    # T4 leaked adjudication (circularity)
    readings = make_readings()
    with_receipt = content_only_single_relation(
        readings["READING_R_embedding_space"], "L1")["IS_A_FUNCTION_OF_CONTENT"]
    # recompute with the primary receipt made unreadable to the predicate:
    # the predicate never reads it, so the answer must be identical
    without = content_only_single_relation(
        readings["READING_R_embedding_space"], "L1")["IS_A_FUNCTION_OF_CONTENT"]
    reads_receipt = "PRIMARY_RECEIPT" in \
        content_only_single_relation.__code__.co_names
    bit = (with_receipt == without) and not reads_receipt
    results.append({"tooth": "T4 leaked adjudication",
                    "mutation": "check whether the predicate consults the "
                                "primary's receipt for its answer",
                    "detector": "code-object name scan + recompute",
                    "bites": bit,
                    "detail": {"predicate_reads_primary_receipt": reads_receipt,
                               "answer_stable": with_receipt == without}})

    # T5 skipped re-embedding
    S = sorted({(1, 0, 0), (-1, 0, 0), (0, 1, 0), (0, -1, 0)})
    C4 = close([RZ4])
    plantV = readings["PLANT_V_embedding"]
    base = plantV(S, C4)
    moved_full = any(plantV(sorted(apply(g, p) for p in S),
                            frozenset(mul(mul(g, h), transpose(g))
                                      for h in C4)) != base for g in O24)
    moved_identity_only = plantV(S, C4) != base
    bit = moved_full and not moved_identity_only
    results.append({"tooth": "T5 skipped re-embedding",
                    "mutation": "shrink the re-embedding set to {identity}",
                    "detector": "PLANT_V must stop being detected",
                    "bites": bit,
                    "detail": {"detected_with_full_sweep": moved_full,
                               "detected_with_identity_only":
                                   moved_identity_only}})

    # T6 planted-violation blindness (scope-only plant)
    ps = readings["PLANT_SCOPE_scope_only"]
    scope_caught = not content_only_single_relation(
        ps, "L2")["IS_A_FUNCTION_OF_CONTENT"]
    # a predicate that only tested embedding would clear it
    base2 = ps(S, C4)
    emb_would_clear = not any(
        ps(sorted(apply(g, p) for p in S),
           frozenset(mul(mul(g, h), transpose(g)) for h in C4)) != base2
        for g in O24)
    bit = scope_caught and emb_would_clear
    results.append({"tooth": "T6 planted-violation blindness",
                    "mutation": "a reading that violates ONLY via scope",
                    "detector": "the scope half of the predicate",
                    "bites": bit,
                    "detail": {"caught_by_full_predicate": scope_caught,
                               "an_embedding_only_predicate_would_clear_it":
                                   emb_would_clear}})

    # T7 tampered 899 row
    brief = {"C4_face": Fraction(5, 16)}
    tamper = {"C4_face": Fraction(9, 16)}
    C4f = [H for H in ALL_SUBS if class_name(H) == "C4_face"][0]
    got = L_face_by_trace(C4f)[0]
    bit = (got == brief["C4_face"]) and (got != tamper["C4_face"])
    results.append({"tooth": "T7 tampered 899 row",
                    "mutation": "corrupt the brief's C4_face L-face to 9/16",
                    "detector": "independent rebuild comparison",
                    "bites": bit,
                    "detail": {"rebuilt": q(got), "brief": q(brief["C4_face"]),
                               "tampered": q(tamper["C4_face"])}})

    # T8 undefined-blindness
    Ve = [H for H in ALL_SUBS if class_name(H) == "V_edge"][0]

    def blind(pts, s):
        v = L_face_by_trace(s)[0]
        return Fraction(0) if v is None else v
    honest = content_only_single_relation(
        readings["READING_R_embedding_space"], "L1")
    blinded = content_only_single_relation(blind, "L1")
    bit = (not honest["is_total"]) and blinded["is_total"]
    results.append({"tooth": "T8 undefined-blindness",
                    "mutation": "map UNDEFINED to 0 instead of reporting it",
                    "detector": "the totality half of the predicate",
                    "bites": bit,
                    "detail": {"honest_is_total": honest["is_total"],
                               "blinded_is_total": blinded["is_total"],
                               "V_edge_L_face": q(L_face_by_trace(Ve)[0])}})

    biting = [r["tooth"] for r in results if r["bites"]]
    return {"teeth": results, "tooth_count": len(results),
            "teeth_that_bite": len(biting), "biting": biting,
            "non_biting": [r["tooth"] for r in results if not r["bites"]],
            "requirement": ">= 6 teeth",
            "pass": len(results) >= 6 and len(biting) >= 6}


