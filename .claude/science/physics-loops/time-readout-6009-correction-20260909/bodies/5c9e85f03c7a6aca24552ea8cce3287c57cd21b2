def content_of(pts) -> tuple:
    """The record content of a collection.  Records lock possibilities; the
    test data are UNIFORM (every record locks the same admissible
    possibility), so content is fully described by the record count.  This is
    a deliberate simplification and it is the checker's exposed flank:
    it is recorded in the receipt as a scope limit."""
    return ("uniform", len(pts))


def admissible_pairs(ladder: str):
    """Enumerate (record collection, scope) pairs.  Collections are the free
    orbits of every non-trivial subgroup; scopes are drawn by the ladder."""
    collections = []
    seen = set()
    for H in ALL_SUBS:
        if len(H) == 1:
            continue
        pts = tuple(free_orbit(H))
        if pts in seen:
            continue
        seen.add(pts)
        collections.append(pts)
    out = []
    for pts in collections:
        P = set(pts)
        for S in ALL_SUBS:
            if len(S) == 1:
                continue
            if not all(apply(h, p) in P for h in S for p in P):
                continue
            if ladder == "L1":
                if len(S) == len(P) and len(orbits(S, P)) == 1:
                    out.append((pts, S))
            else:
                out.append((pts, S))
    return out


def content_only_single_relation(fn, ladder: str) -> dict:
    """THE CHECKER'S OWN FORMALIZATION.

    "A readout value is determined by record content alone" is read as ONE
    condition: the relation

        REL = { (content(D), fn(D, s)) : (D, s) admissible }

    must be a FUNCTION -- single-valued on every content, and defined
    everywhere.  No P_EMB / P_SCOPE / P_TOTAL split is used."""
    rel: dict[tuple, set] = {}
    undefined: dict[tuple, list] = {}
    for pts, S in admissible_pairs(ladder):
        c = content_of(pts)
        v = fn(pts, S)
        rel.setdefault(c, set()).add(q(v))
        if v is None:
            undefined.setdefault(c, []).append(class_name(S))
    multi = {str(c): sorted(v) for c, v in rel.items() if len(v) > 1}
    partial = {str(c): sorted(set(v)) for c, v in undefined.items()}
    return {
        "ladder": ladder,
        "contents_tested": len(rel),
        "relation": {str(c): sorted(v) for c, v in sorted(rel.items())},
        "contents_with_more_than_one_value": multi,
        "contents_where_the_construction_is_undefined": partial,
        "is_single_valued": not multi,
        "is_total": not partial,
        "IS_A_FUNCTION_OF_CONTENT": (not multi) and (not partial),
    }


def make_readings():
    def reading_D(pts, S):
        return F_dim(len(pts))

    def reading_R(pts, S):
        return L_face_by_trace(S)[0]

    def plant_V(pts, S):
        """violates by embedding only"""
        return Fraction(sorted(pts)[0][0])

    def plant_scope(pts, S):
        """violates by SCOPE only -- embedding-invariant, total, but reads
        the scope's order.  A predicate lacking a scope test would pass it."""
        return Fraction(len(S))

    def plant_S(pts, S):
        """survives"""
        return Fraction(len(pts))

    return {"READING_D_content_space": reading_D,
            "READING_R_embedding_space": reading_R,
            "PLANT_V_embedding": plant_V,
            "PLANT_SCOPE_scope_only": plant_scope,
            "PLANT_S_content_only": plant_S}


