def check_pins() -> dict:
    rows, ok = [], True
    for rel in PINS:
        p = ROOT / rel
        exists = p.is_file()
        raw = p.read_bytes() if exists else b""
        sha = hashlib.sha256(raw).hexdigest()
        match = (sha == BRIEF_SHA256[rel]) if rel in BRIEF_SHA256 else None
        ok &= exists and (match is not False)
        rows.append({"path": rel, "exists": exists, "bytes": len(raw),
                     "sha256": sha, "git_blob": git_blob(rel) if exists
                     else None, "brief_sha256_match": match})
    ax = norm(rd(AXIOMS_MD))
    needles = {"content_alone": ax.count(CONTENT_ALONE),
               "additivity": ax.count(ADDITIVITY)}
    ok &= all(v == 1 for v in needles.values())
    ok &= len(FIREWALL.hits) == 0
    return {"pins": rows, "needle_occurrences": needles,
            "import_firewall_hits": len(FIREWALL.hits),
            "self_sha256": hashlib.sha256(
                (ROOT / SELF_REL).read_bytes()).hexdigest(),
            "pass": ok}


def check_group() -> dict:
    """Independent construction; cross-check against the pinned 888 census."""
    census = json.loads(rd(C888_RECEIPT))["subgroup_lattice_census"]
    seen, rebuilt = set(), []
    for H in ALL_SUBS:
        nm = class_name(H)
        if nm in seen:
            continue
        seen.add(nm)
        rebuilt.append({"name": nm, "order": len(H), "size": class_size(H),
                        "is_cyclic": is_cyclic(H),
                        "normalizer_order": normalizer_order(H)})
    by = {r["name"]: r for r in rebuilt}
    rows, ok = [], True
    for pr in census:
        mine = by.get(pr["name"])
        f = ("order", "size", "is_cyclic", "normalizer_order")
        agree = mine is not None and all(mine[k] == pr[k] for k in f)
        ok &= agree
        rows.append({"name": pr["name"], "agrees": agree,
                     "pinned": {k: pr[k] for k in f},
                     "checker": {k: mine[k] for k in f} if mine else None})
    return {"group_order": len(O24), "group_order_is_24": len(O24) == 24,
            "construction": "closure of a 4-fold and a 3-fold rotation",
            "subgroup_count": len(ALL_SUBS),
            "census_rows": rows, "census_agrees": ok,
            "pass": ok and len(O24) == 24}


def check_L_face_independently() -> dict:
    """Independent L-face at both C2 classes, all conjugates, and V_edge."""
    primary = json.loads(rd(PRIMARY_RECEIPT))["certificates"]
    rows, ok = [], True
    per_class: dict[str, set] = {}
    for H in ALL_SUBS:
        nm = class_name(H)
        if nm == "E_trivial":
            continue
        v, why = L_face_by_trace(H)
        per_class.setdefault(nm, set()).add(q(v))
        rows.append({"class": nm, "order": len(H), "L_face_by_trace": q(v),
                     "status": why,
                     "traces": sorted(tr(h) for h in H if h != I3)})
    # cross-check the cyclic closed form
    closed_form_ok = True
    for nm, vals in per_class.items():
        H = [G for G in ALL_SUBS if class_name(G) == nm][0]
        if is_cyclic(H) and len(H) > 1:
            closed_form_ok &= vals == {q(F_res(len(H)))}
    # the primary's own numbers
    prim_c2 = {"C2_face": primary["F_C2_DISCRIMINATOR"]["C2_face_L_values"],
               "C2_edge": primary["F_C2_DISCRIMINATOR"]["C2_edge_L_values"]}
    c2_agree = (sorted(per_class["C2_face"]) == prim_c2["C2_face"]
                and sorted(per_class["C2_edge"]) == prim_c2["C2_edge"])
    conj_agree = all(len(v) == 1 for v in per_class.values())
    vedge_undef = per_class["V_edge"] == {"UNDEFINED"}
    prim_conj = primary["G_CONJUGATE"]["all_conjugates_agree"]
    return {
        "method": "trace identity det_R(I - h|_N) = 3 - tr(h); no basis built",
        "rank_routine": "fraction-free Bareiss elimination",
        "rows": rows,
        "values_per_class": {k: sorted(v) for k, v in
                             sorted(per_class.items())},
        "cyclic_closed_form_(n^2-1)/(12n)_confirmed": closed_form_ok,
        "C2_face_values": sorted(per_class["C2_face"]),
        "C2_edge_values": sorted(per_class["C2_edge"]),
        "C2_classes_agree_with_each_other": (per_class["C2_face"]
                                             == per_class["C2_edge"]),
        "C2_agrees_with_primary": c2_agree,
        "all_conjugates_agree_within_each_class": conj_agree,
        "primary_said_conjugates_agree": prim_conj,
        "conjugate_test_agrees_with_primary": conj_agree == prim_conj,
        "V_edge_is_undefined": vedge_undef,
        "REFUTATION_ATTEMPT": (
            "tried to find a C2 class, a conjugate, or an axis choice where "
            "the L-face moves.  FAILED to refute: the L-face is 1/8 on all 3 "
            "C2_face and all 6 C2_edge subgroups, 2/9 on all 4 C3_body, 5/16 "
            "on all 3 C4_face.  The primary's honest report that the "
            "geometric reading SURVIVES the C2 and conjugate tests is "
            "CONFIRMED by an independent route."),
        "pass": c2_agree and closed_form_ok,
    }


def check_predicate_formalization_stability() -> dict:
    """(1) Does the checker's single-relation formalization reach the same
    verdict as the primary's three-predicate split?"""
    readings = make_readings()
    mine = {}
    for name, fn in readings.items():
        mine[name] = {lad: content_only_single_relation(fn, lad)
                      for lad in ("L1", "L2")}
    primary = json.loads(rd(PRIMARY_RECEIPT))["certificates"]["E_PREDICATE"]
    prim_sum = primary["summary"]

    def checker_says(name):
        return all(mine[name][lad]["IS_A_FUNCTION_OF_CONTENT"]
                   for lad in ("L1", "L2"))

    comparisons = []
    for name in ("READING_D_content_space", "READING_R_embedding_space"):
        p = prim_sum[name]["content_only"]
        c = checker_says(name)
        comparisons.append({
            "reading": name,
            "primary_three_predicate_verdict": p,
            "checker_single_relation_verdict": c,
            "formalizations_agree": p == c,
        })
    agree = all(cm["formalizations_agree"] for cm in comparisons)
    # does the checker's formalization also catch a scope-only plant?
    scope_plant_caught = not checker_says("PLANT_SCOPE_scope_only")
    emb_plant_caught = not checker_says("PLANT_V_embedding")
    survivor_ok = checker_says("PLANT_S_content_only")
    return {
        "checker_formalization": (
            "ONE condition: the relation from record content to value must be "
            "a total single-valued function.  No P_EMB / P_SCOPE / P_TOTAL "
            "split."),
        "primary_formalization": (
            "THREE predicates: P_EMB (re-embedding invariance), P_SCOPE "
            "(scope-independence), P_TOTAL (totality)."),
        "detail": mine,
        "comparisons": comparisons,
        "VERDICT_IS_FORMALIZATION_STABLE": agree,
        "material_difference": (
            "NONE for either candidate reading.  The two formalizations are "
            "not the same statement -- the checker's is a single relational "
            "condition and the primary's is a conjunction of three -- but "
            "they agree on both readings on both scope ladders.  The "
            "predicate is therefore IDENTIFIABLE on the data that matters."
            if agree else
            "MATERIAL DISAGREEMENT -- the content-only predicate is NOT "
            "identifiable and the verdict must be downgraded to "
            "UNDECIDABLE-PRICED with the formalization named as the price."),
        "checker_catches_embedding_plant": emb_plant_caught,
        "checker_catches_scope_only_plant": scope_plant_caught,
        "checker_passes_content_only_plant": survivor_ok,
        "note_on_the_scope_only_plant": (
            "PLANT_SCOPE is embedding-invariant and total, so a predicate "
            "built from P_EMB and P_TOTAL alone would clear it.  Both "
            "formalizations catch it, which is what makes P_SCOPE (or its "
            "single-relation equivalent) load-bearing rather than decorative."),
        "exposed_flank": (
            "content_of() treats the test data as UNIFORM content, so content "
            "equivalence reduces to record count.  This is legitimate for the "
