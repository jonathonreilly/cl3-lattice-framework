          f"{len(succeeded)}")
    print(f"teeth: {checks['H_TEETH']['tooth_count']}, biting: "
          f"{checks['H_TEETH']['teeth_that_bite']}")
    print(f"receipt: {OUT_JSON.relative_to(ROOT)}")
    print(f"elapsed_sec: {round(time.time() - START, 3)}")
    return 0


