I3 = ((1, 0, 0), (0, 1, 0), (0, 0, 1))
RZ4 = ((0, -1, 0), (1, 0, 0), (0, 0, 1))       # 4-fold about z
RB3 = ((0, 0, 1), (1, 0, 0), (0, 1, 0))        # 3-fold about (1,1,1)


def mul(a, b):
    return tuple(tuple(sum(a[i][k] * b[k][j] for k in range(3))
                       for j in range(3)) for i in range(3))


def apply(m, v):
    return tuple(sum(m[i][j] * v[j] for j in range(3)) for i in range(3))


def tr(m) -> int:
    return m[0][0] + m[1][1] + m[2][2]


def transpose(m):
    return tuple(tuple(m[j][i] for j in range(3)) for i in range(3))


def close(gens) -> frozenset:
    G = {I3}
    changed = True
    while changed:
        changed = False
        for x in list(G):
            for g in gens:
                y = mul(x, g)
                if y not in G:
                    G.add(y)
                    changed = True
    return frozenset(G)


O24 = sorted(close([RZ4, RB3]))


def order_of(m) -> int:
    k, c = 1, m
    while c != I3:
        c = mul(c, m)
        k += 1
        if k > 24:
            raise AssertionError("infinite order")
    return k


def subgroups() -> list[frozenset]:
    out = set()
    for a in O24:
        for b in O24:
            out.add(close([a, b]))
    return sorted(out, key=lambda H: (len(H), sorted(map(str, H))))


ALL_SUBS = subgroups()


def is_cyclic(H) -> bool:
    return len(H) == 1 or any(order_of(h) == len(H) for h in H)


def normalizer_order(H) -> int:
    n = 0
    for g in O24:
        gi = transpose(g)
        if frozenset(mul(mul(g, h), gi) for h in H) == H:
            n += 1
    return n


def class_size(H) -> int:
    return len({frozenset(mul(mul(g, h), transpose(g)) for h in H)
                for g in O24})


def class_name(H) -> str:
    if len(H) == 1:
        return "E_trivial"
    key = (len(H), is_cyclic(H),
           all(mul(x, y) == mul(y, x) for x in H for y in H),
           normalizer_order(H))
    return {(2, True, True, 8): "C2_face", (2, True, True, 4): "C2_edge",
            (3, True, True, 6): "C3_body", (4, False, True, 24): "V_face",
            (4, False, True, 8): "V_edge", (4, True, True, 8): "C4_face",
            (6, False, False, 6): "S3_body", (8, False, False, 8): "D4_face",
            (12, False, False, 24): "A4_tetrahedral",
            (24, False, False, 24): "O_full"}.get(key, f"UNCLASSIFIED{key}")


# ==========================================================================
# (3) INDEPENDENT L-FACE ROUTE -- trace identity + Bareiss rank
# ==========================================================================
def bareiss_rank(rows: list[list[int]]) -> int:
    """Fraction-free Gaussian elimination.  Deliberately a different routine
    from the primary's rational RREF."""
    M = [r[:] for r in rows]
    n, m = len(M), (len(M[0]) if M else 0)
    rank = 0
    prev = 1
    for col in range(m):
        piv = None
        for r in range(rank, n):
            if M[r][col] != 0:
                piv = r
                break
        if piv is None:
            continue
        M[rank], M[piv] = M[piv], M[rank]
        for r in range(rank + 1, n):
            for c in range(col + 1, m):
                M[r][c] = (M[r][c] * M[rank][col] - M[r][col] * M[rank][c])
                M[r][c] //= prev
            M[r][col] = 0
        prev = M[rank][col]
        rank += 1
        if rank == n:
            break
    return rank


def common_fixed_dim(H) -> int:
    rows = []
    for h in H:
        for i in range(3):
            rows.append([h[i][j] - (1 if i == j else 0) for j in range(3)])
    return 3 - bareiss_rank(rows)


def L_face_by_trace(H):
    """det_R(I - h|_N) = 3 - tr(h) for any rotation h with a 1-dim axis.

    Derivation: h has eigenvalues {1, e^{i t}, e^{-i t}}, so tr(h) = 1 +
    2 cos t and det_R(I - h|_N) = (1 - e^{i t})(1 - e^{-i t}) = 2 - 2 cos t
    = 2 - (tr(h) - 1) = 3 - tr(h).  No basis is constructed."""
    if len(H) == 1:
        return None, "trivial group: no non-identity element"
    if common_fixed_dim(H) != 1:
        return None, f"common fixed locus has dim {common_fixed_dim(H)}, not 1"
    total = Fraction(0)
    for h in H:
        if h == I3:
            continue
        d = 3 - tr(h)
        if d == 0:
            return None, "singular"
        total += Fraction(1, d)
    return total / len(H), "defined"


def F_dim(n: int) -> Fraction:
    return Fraction(n - 1, n * n)


def F_res(n: int) -> Fraction:
    return Fraction(n * n - 1, 12 * n)


def orbits(H, pts):
    rem, out = set(pts), []
    while rem:
        p = sorted(rem)[0]
        o = {apply(h, p) for h in H}
        out.append(sorted(o))
        rem -= o
    return sorted(out)


def free_orbit(H):
    box = sorted([(x, y, z) for x in range(-2, 3) for y in range(-2, 3)
                  for z in range(-2, 3) if (x, y, z) != (0, 0, 0)],
                 key=lambda p: (sum(c * c for c in p), p))
    for p in box:
        o = {apply(h, p) for h in H}
        if len(o) == len(H):
            return sorted(o)
    raise AssertionError("no free orbit")


