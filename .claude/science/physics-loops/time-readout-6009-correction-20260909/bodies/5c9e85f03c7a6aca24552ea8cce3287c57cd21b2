def main() -> int:
    checks = {}
    checks["A_PINS"] = check_pins()
    checks["B_GROUP"] = check_group()
    checks["C_L_FACE_INDEPENDENT"] = check_L_face_independently()
    checks["D_FORMALIZATION_STABILITY"] = \
        check_predicate_formalization_stability()
    checks["E_CRUX"] = check_crux_independently()
    checks["F_STEELMAN_BYTES"] = check_steelman_from_bytes()
    checks["G_CONSUMERS"] = check_consumers_independently()
    checks["H_TEETH"] = teeth()

    primary = json.loads(rd(PRIMARY_RECEIPT))
    prim_verdict = primary["VERDICT"]
    stable = checks["D_FORMALIZATION_STABILITY"]["VERDICT_IS_FORMALIZATION_STABLE"]
    crux_holds = (not checks["E_CRUX"]["geometric_single_valued_L1"]
                  and checks["E_CRUX"]["content_single_valued"])
    l_agrees = checks["C_L_FACE_INDEPENDENT"]["C2_agrees_with_primary"]
    survives = stable and crux_holds and l_agrees and checks["B_GROUP"]["pass"]

    refutations = [
        {"attempt": "break the L-face's embedding-invariance at a C2 class "
                    "or a conjugate",
         "succeeded": not checks["C_L_FACE_INDEPENDENT"]["pass"]},
        {"attempt": "reach a different verdict from an independent "
                    "single-relation formalization of content-alone",
         "succeeded": not stable},
        {"attempt": "show the crux collection is a fluke among multi-scope "
                    "collections",
         "succeeded": checks["E_CRUX"][
             "collections_where_the_geometric_reading_splits"] == 0},
        {"attempt": "defend 'subgroup type is content' from the memo's bytes",
         "succeeded": checks["F_STEELMAN_BYTES"]["pro_steelman_count"] > 0,
         "note": (
             f"raw token co-occurrence found "
             f"{checks['F_STEELMAN_BYTES']['raw_token_cooccurrence_count']} "
             f"sentence(s); adjudicated for polarity, "
             f"{checks['F_STEELMAN_BYTES']['pro_steelman_count']} support the "
             f"steelman")},
        {"attempt": "find a retained consumer that evaluates the L-face "
                    "off-C3, making the re-binding bite",
         "succeeded": checks["G_CONSUMERS"]["genuine_off_C3_count"] > 0,
         "note": (
             f"{len(checks['G_CONSUMERS']['consumers_with_off_C3_value_needles_too'])} "
             f"raw candidate(s), "
             f"{checks['G_CONSUMERS']['genuine_off_C3_count']} genuine after "
             f"line-level adjudication")},
        {"attempt": "show the group construction or the 888 census is wrong",
         "succeeded": not checks["B_GROUP"]["pass"]},
        {"attempt": "show the verdict selector is hardcoded",
         "succeeded": not [t for t in checks["H_TEETH"]["teeth"]
                           if t["tooth"].startswith("T3")][0]["bites"]},
        {"attempt": "show the predicate is circular (reads the primary's "
                    "answer)",
         "succeeded": not [t for t in checks["H_TEETH"]["teeth"]
                           if t["tooth"].startswith("T4")][0]["bites"]},
    ]
    succeeded = [r["attempt"] for r in refutations if r["succeeded"]]

    receipt = {
        "cycle": CYCLE,
        "role": "independent check, spec'd to refute",
        "block": "toe-time-blockG24-20260802",
        "primary_verdict": prim_verdict,
        "checker_verdict": (
            "PRIMARY CLAIM SURVIVES" if survives else
            "PRIMARY CLAIM DOES NOT SURVIVE -- see refutations_that_succeeded"),
        "verdict_is_formalization_stable": stable,
        "refutation_attempts": refutations,
        "refutations_that_succeeded": succeeded,
        "refutation_attempt_count": len(refutations),
        "checks": checks,
        "teeth_summary": {"count": checks["H_TEETH"]["tooth_count"],
                          "biting": checks["H_TEETH"]["teeth_that_bite"],
                          "non_biting": checks["H_TEETH"]["non_biting"]},
        "what_the_checker_adds_beyond_the_primary": [
            "an independent single-relation formalization of content-alone, "
            "reaching the same verdict -- the predicate is identifiable",
            "a scope-only plant (PLANT_SCOPE) that an embedding-only "
            "predicate would clear, proving the scope half is load-bearing",
            "a survey of EVERY multi-scope record collection, not just the "
            "crux one",
            "a byte-level attack on 'subgroup type is content' over every "
            "sentence in the memo containing the word 'content'",
            "the trace identity det_R(I - h|_N) = 3 - tr(h), which makes the "
            "L-face's axis-independence transparent rather than computed",
        ],
        "runtime_seconds": round(time.time() - START, 3),
    }
    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
    OUT_JSON.write_text(json.dumps(receipt, indent=1, sort_keys=True,
                                   default=str))

    print("=" * 78)
    print(f"CYCLE {CYCLE} -- INDEPENDENT CHECK (spec'd to refute)")
    print("=" * 78)
    for k, v in checks.items():
        print(f"\n[{k}]  pass={v.get('pass')}")
        for kk, vv in v.items():
            if kk == "pass":
                continue
            blob = json.dumps(vv, default=str) if isinstance(
                vv, (list, dict)) else str(vv)
            if len(blob) > 3600:
                blob = blob[:3600] + " ...<truncated>"
            print(f"    {kk}: {blob}")
    print("\n" + "=" * 78)
    print(f"primary_verdict: {prim_verdict}")
    print(f"checker_verdict: {receipt['checker_verdict']}")
    print(f"verdict_is_formalization_stable: {stable}")
