+I2 = sp.eye(2)
+I3 = sp.eye(3)
+SX = sp.Matrix([[0, 1], [1, 0]])
+SY = sp.Matrix([[0, -sp.I], [sp.I, 0]])
+SZ = sp.diag(1, -1)
+PAULI = (SX, SY, SZ)
+DIRS = (
+    sp.Matrix([1, 0, 0]),
+    sp.Matrix([-1, 0, 0]),
+    sp.Matrix([0, 1, 0]),
+    sp.Matrix([0, -1, 0]),
