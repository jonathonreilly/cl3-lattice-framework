+
+@dataclass
+class Harness:
+    passed: int = 0
+    failed: int = 0
+
+    def check(self, label: str, condition: bool, detail: str) -> None:
+        if condition:
+            self.passed += 1
+            print(f"PASS {label} :: {detail}")
+        else:
