+def inertia(matrix: np.ndarray, tolerance: float = 1.0e-9) -> tuple[int, int, int]:
+    values = np.linalg.eigvalsh(0.5 * (matrix + matrix.conj().T))
+    return (
+        int(np.sum(values < -tolerance)),
+        int(np.sum(values > tolerance)),
+        int(np.sum(np.abs(values) <= tolerance)),
+    )
