+def local_weights(
+    direction: Vec,
+    power: int = 1,
+    break_normalization: bool = False,
+) -> dict[int, sp.Expr]:
+    k = block84.k_value(direction)
+    weights = {
+        sign: block84.response_weight(k, sign, power)
+        for sign in (-1, 1)
+    }
+    if break_normalization and direction == (1, 0, 0):
+        weights[1] = sp.simplify(weights[1] + sp.Rational(1, 100))
+    return weights
