+        }
+        response_failures += sp.simplify(sum(linear.values()) - 1) != 0
+        response_failures += sp.simplify(sum(cubic.values()) - 1) != 0
+        response_failures += any(
+            weight.is_positive is not True
+            for weight in (*linear.values(), *cubic.values())
